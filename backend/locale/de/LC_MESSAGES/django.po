#: opencast/views.py:30
msgid "Opencast is not configured."
msgstr "Opencast ist nicht konfiguriert."

#: recorders/models.py:21
msgid "On time (Opencast start)"
msgstr "Pünktlich (Opencast-Start)"

#: recorders/models.py:22
msgid "Grid (c.t.)"
msgstr "Raster (c.t.)"

#: recorders/models.py:23
msgid "Off (log only)"
msgstr "Aus (nur protokollieren)"

#: recorders/serializers.py:273
msgid "Must be an https URL."
msgstr "Muss eine https-URL sein."

#: recorders/serializers.py:276
msgid "Must include the project path."
msgstr "Muss den Projektpfad enthalten."

#: recorders/serializers.py:302
msgid "Must be shorter than the slot length."
msgstr "Muss kürzer als die Slotlänge sein."

#: recorders/serializers.py:314
msgid "Must not be shorter than the minimum logged silence."
msgstr ""
"Darf nicht kürzer sein als die Mindestdauer einer protokollierten Stille."

#: recorders/validators.py:19
msgid ""
"Only letters, digits, '.', '_' and '-' are allowed (must start with a letter "
"or digit)."
msgstr ""
"Erlaubt sind nur Buchstaben, Ziffern, „.“, „_“ und „-“ (der Name muss mit "
"einem Buchstaben oder einer Ziffer beginnen)."

#: recorders/validators.py:28
msgid "The URL template must start with https://."
msgstr "Die URL-Vorlage muss mit https:// beginnen."

#: recorders/validators.py:30
#, python-brace-format
msgid "The URL template must contain {stream} exactly once."
msgstr "Die URL-Vorlage muss {stream} genau einmal enthalten."

#: recorders/validators.py:33
msgid "The URL template must not contain other braces."
msgstr "Die URL-Vorlage darf keine weiteren geschweiften Klammern enthalten."

#: recorders/views.py:51
msgid "Only deactivated recorders can be deleted."
msgstr "Nur deaktivierte Rekorder können gelöscht werden."

#: recorders/views.py:76
msgid "Invalid date in \"from\"."
msgstr "Ungültiges Datum in \"from\"."

#: recorders/views.py:83
msgid "\"days\" must be a number from 1 to 7."
msgstr "\"days\" muss eine Zahl von 1 bis 7 sein."
