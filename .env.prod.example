# Production configuration for docker-compose.prod.yml — copy to .env on the
# server and fill in. docker compose reads .env automatically; variables the
# compose file marks with `:?` are mandatory.

# Public URL of the instance (no trailing slash).
PUBLIC_BASE_URL=https://ansehbar.example.org

# Django. The dev key is refused when DJANGO_DEBUG=0 (settings.py).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=ansehbar.example.org
CSRF_TRUSTED_ORIGINS=https://ansehbar.example.org

# PostgreSQL
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Pin a specific released image (see docker-compose.prod.yml `app`). Unset = latest.
#ANSEHBAR_VERSION=v1.2.0

# OIDC — institutional IdP. With OIDC_OP_ISSUER set, the endpoints are read
# from the discovery document; explicit OIDC_OP_* values win over it.
OIDC_RP_CLIENT_ID=ansehbar
OIDC_RP_CLIENT_SECRET=change-me
OIDC_OP_ISSUER=https://sso.example.org/realms/example
# Members of this IdP group get Django admin on login (empty = disabled).
OIDC_ADMIN_GROUP=
OIDC_GROUPS_CLAIM=groups
# Claim names — uncomment only if the IdP uses non-standard ones.
#OIDC_CLAIM_USERNAME=preferred_username
#OIDC_CLAIM_EMAIL=email
#OIDC_CLAIM_FIRST_NAME=given_name
#OIDC_CLAIM_LAST_NAME=family_name
# Heal re-issued IdP subjects by username — only where usernames are never
# re-assigned to different people (basicbar-auth README, operator notes).
#OIDC_MATCH_BY_USERNAME_FALLBACK=1
# Optional AI features via a LiteLLM proxy. All four required to switch on.
AI_PROVIDER=none
#AI_PROVIDER=litellm
#AI_BASE_URL=https://litellm.example.org/v1
#AI_API_KEY=sk-change-me
#AI_MODEL=qwen-3.5
#AI_TIMEOUT=30
#AI_MAX_TOKENS=2000
#AI_DISABLE_THINKING=1

# Content i18n: canonical language of authored content (one of de/en) and the
# optional LibreTranslate pre-fill in the editor (never overwrites a human
# translation — it only fills an empty language).
CONTENT_DEFAULT_LANGUAGE=de
CONTENT_TRANSLATION_PROVIDER=none
#CONTENT_TRANSLATION_PROVIDER=libretranslate
#LIBRETRANSLATE_URL=https://libretranslate.example.org
#LIBRETRANSLATE_API_KEY=change-me

# ansehBAR access control. Members of this IdP group may use the tool.
ANSEHBAR_ACCESS_GROUP=ansehbar-users
# Comma-separated usernames allowed in without group membership (bootstrap).
ANSEHBAR_BOOTSTRAP_USERS=
# Contact shown to users who are denied access (e.g. a mail address).
ANSEHBAR_ACCESS_CONTACT=
# Seconds between stream status checks.
MONITOR_INTERVAL_SECONDS=10

# Opencast External API (read-only: schedule and agents). Empty URL = Opencast
# integration off. Use a dedicated read-only account.
#OPENCAST_URL=https://opencast.example.org
#OPENCAST_USER=ansehbar
# Docker Compose interpolates `$` in .env values: write a literal `$` as `$$`.
#OPENCAST_PASSWORD=change-me
# Seconds between schedule syncs; days of schedule to look ahead and back.
#OPENCAST_SYNC_SECONDS=60
#OPENCAST_LOOKAHEAD_DAYS=7
#OPENCAST_LOOKBACK_DAYS=7

# Local site configuration (recorders, stream URL template) for
# `manage.py load_site_config`. Default: backend/site.local.json. In production
# usually fed via stdin instead (`--path -`), see README "Standortkonfiguration".
#ANSEHBAR_SITE_CONFIG=/app/site.local.json

# Alarm e-mails (stream alarms and all-clear notices). Sent by the monitor via
# SMTP. Without EMAIL_HOST nothing leaves the machine.
#EMAIL_HOST=smtp.example.org
#EMAIL_PORT=587
#EMAIL_HOST_USER=ansehbar
#EMAIL_HOST_PASSWORD=change-me
#EMAIL_USE_TLS=1
# Seconds before a hanging SMTP connection is given up.
#EMAIL_TIMEOUT=10
#DEFAULT_FROM_EMAIL=ansehbar@example.org
# Language of the alarm e-mails (de/en), the same for all recipients.
#ALARM_LANGUAGE=de
# Only to override the default SMTP backend, e.g. for tests.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
