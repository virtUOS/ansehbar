{
  "realm": "ansehbar",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "ansehbar-backend",
      "name": "ansehBAR Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ansehbar-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8007/*"
      ],
      "webOrigins": [
        "http://localhost:8007",
        "http://localhost:5179"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5179/*##http://localhost:8007/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
